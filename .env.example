# Ollama server and models
OLLAMA_BASE_URL=http://localhost:11434
# Chọn model Ollama phù hợp với cấu hình máy:
# - Máy có GPU >= 6GB VRAM (khuyên dùng 7B): qwen2.5:7b-instruct-q4_0 (hoặc qwen2.5:7b)
# - Máy nhẹ / CPU / GPU 2-4GB (dùng 3B): qwen2.5:3b
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_0
OLLAMA_TIMEOUT_SECONDS=90

# Embedding backend
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Project paths
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=dhv_admissions_2026
# Generated Structured JSON
PROCESSED_DATA_DIR=data/processed

# Supabase Auth (use a publishable key, or the legacy anon key; never a service-role key)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy key name accepted as a fallback:
SUPABASE_ANON_KEY=

# Retrieval defaults
RETRIEVER_TOP_K=4
TARGET_YEAR=2026
RAG_MAX_CONTEXT_CHARS=12000

# Cửa sổ context (token) gửi cho Ollama. Prompt RAG tiếng Việt cần tới ~8.5k token;
# mặc định của Ollama (2048-4096) sẽ cắt mất phần quy tắc đầu prompt.
OLLAMA_NUM_CTX=12288

# Bật để build_vector_db thu nhỏ chunk cho vừa giới hạn token của model embedding
# (MiniLM-L12 chỉ đọc 128 token). Cần --reset để xây lại ChromaDB.
# CHUNK_ALIGN_TO_EMBEDDING=1
