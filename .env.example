# Ollama server and models
OLLAMA_BASE_URL=http://localhost:11434
# Chọn model Ollama phù hợp với cấu hình máy:
# - Máy có GPU >= 6GB VRAM (khuyên dùng 7B): qwen2.5:7b-instruct-q4_0 (hoặc qwen2.5:7b)
# - Máy nhẹ / CPU / GPU 2-4GB (dùng 3B): qwen2.5:3b
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_0
OLLAMA_TIMEOUT_SECONDS=90

# Embedding backend
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Project paths
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=dhv_admissions_2026
# Generated Structured JSON
PROCESSED_DATA_DIR=data/processed

# Retrieval defaults
RETRIEVER_TOP_K=4
TARGET_YEAR=2026
RAG_MAX_CONTEXT_CHARS=12000
